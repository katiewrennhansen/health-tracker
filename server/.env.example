# Copy to server/.env and fill in your values. Never commit server/.env.

# Clerk dashboard → API keys.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Comma-separated frontend origins whose Clerk tokens the API accepts.
CLIENT_ORIGINS=http://localhost:5173

# Optional. Defaults to the local database from `npm run db:start`.
# DATABASE_URL=postgres://postgres@localhost:5433/health_tracker

# Optional. Defaults to 3001.
# PORT=3001
