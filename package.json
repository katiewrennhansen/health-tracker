{
  "name": "health-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,magenta \"npm run dev -w @health-tracker/server\" \"npm run dev -w @health-tracker/client\"",
    "build": "tsc -b && npm run build -w @health-tracker/client",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "./scripts/db-start.sh",
    "db:stop": "pg_ctl -D .postgres-data stop",
    "db:generate": "npm run db:generate -w @health-tracker/server",
    "db:migrate": "npm run db:migrate -w @health-tracker/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
